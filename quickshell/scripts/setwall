#!/usr/bin/env bash

# Use argument if provided, otherwise fall back to default
if [[ -n "$1" ]]; then
    # Handle both absolute paths and filenames relative to wallpaper dir
    if [[ "$1" = /* ]]; then
        WALL="$1"
    else
        WALL="$HOME/Pictures/wallpapers/$1"
    fi
else
    WALL="$HOME/Pictures/wallpapers/current.jpg"
fi

# Validate the file exists
if [[ ! -f "$WALL" ]]; then
    echo "Error: wallpaper '$WALL' not found"
    exit 1
fi

# Start awww daemon if not running
if ! pgrep -x awww-daemon > /dev/null; then
    awww-daemon > /dev/null 2>&1 &
    sleep 0.5
fi

# Set wallpaper with smooth transition
awww img "$WALL" \
    --transition-type grow \
    --transition-duration 1 \
    --transition-fps 60

# Generate colors using matugen
matugen image "$WALL" --source-color-index 0
awww query | awk -F 'image: ' '{print $2}' | xargs -I{} ln -sf {} ~/.cache/current_wallpaper
