#!/usr/bin/env bash
# Set the wallpaper. Quickshell draws it (services/WallpaperEngine.qml): with
# the shell running this hands over to it, which plays the transition, points
# ~/.cache/current_wallpaper at the image and runs matugen. Without the shell
# it just does the last two (scripts/wallpaper-apply), and the shell shows the
# wallpaper when it starts. Images, GIFs and videos (mp4, webm, mkv, mov) all work.

# Use argument if provided, otherwise fall back to default
if [[ -n "$1" ]]; then
    # Handle both absolute paths and filenames relative to wallpaper dir
    if [[ "$1" = /* ]]; then
        WALL="$1"
    else
        WALL="$HOME/Pictures/wallpapers/$1"
    fi
else
    WALL="$HOME/Pictures/wallpapers/current.jpg"
fi

# Validate the file exists
if [[ ! -f "$WALL" ]]; then
    echo "Error: wallpaper '$WALL' not found"
    exit 1
fi

if qs ipc call wallpaper set "$WALL" >/dev/null 2>&1; then
    exit 0
fi

exec "$HOME/.config/quickshell/scripts/wallpaper-apply" "$WALL"
