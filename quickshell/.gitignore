# State the shell writes at runtime: each install keeps its own. New installs
# start from defaults/ (install.sh copies over whatever is missing).
/barlayout.conf
/barsettings.json
/cavawidget.json
/colors/Colors.json
/config/workspacedisc.json
/desktoptheme.json
/desktopwidgets.json
/lockscreen.json
/pet.json
/calendar_notes.conf
/notepad.conf
/notes.conf
# Generated by install.sh (scripts/gen-ipc-commands.py)
/ipc-commands.json
# Left by install.sh --update next to files you've changed in a --copy install
*.new
/opening.json
/windowlook.json
/palette.json
