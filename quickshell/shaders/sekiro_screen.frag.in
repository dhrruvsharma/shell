#version 320 es
// Screen grade for the Sekiro desktop theme, applied by Hyprland to the
// whole output (decoration:screen_shader). services/DesktopTheme.qml fills
// in the @PLACEHOLDERS@ from the theme's crimson and season colour and
// writes the result to ~/.cache/quickshell/desktop-theme.frag.
//
// Deliberately static: it never reads `time`, so Hyprland keeps its damage
// tracking and an idle desktop costs nothing.

precision highp float;

in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

const vec3 blood = vec3(@ACCENT@);
const vec3 season = vec3(@ACCENT2@);
const float strength = @STRENGTH@;
const float strong = @STRONG@;

float grain(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

vec3 hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
}

void main() {
    vec4 c = texture(tex, v_texcoord);
    float lum = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));

    // Ashina at dusk: a painter's grade. Colour settles a little, except
    // the reds and the oranges (maples, blood, fire), which keep burning;
    // the shadows go cool and blue-grey, the light warm, and the corners
    // darken.
    vec3 h = hsv(c.rgb);
    float dr = min(h.x, 1.0 - h.x);
    float warm = (1.0 - smoothstep(0.06, 0.12, dr)) * smoothstep(0.15, 0.4, h.y);
    c.rgb = mix(c.rgb, vec3(lum), 0.2 * strength * (1.0 - warm));
    c.rgb = mix(c.rgb, c.rgb * vec3(1.08, 0.97, 0.95), warm * 0.25 * strength);
    float shade = 1.0 - smoothstep(0.0, 0.45, lum);
    c.rgb = mix(c.rgb, c.rgb * vec3(0.86, 0.9, 1.02), shade * 0.35 * strength);
    float high = smoothstep(0.55, 1.0, lum);
    c.rgb = mix(c.rgb, c.rgb * vec3(1.06, 0.99, 0.88), high * 0.22 * strength);
    vec2 d = v_texcoord - 0.5;
    float vig = smoothstep(0.38, 0.85, length(d * vec2(1.25, 1.0)));
    c.rgb *= 1.0 - vig * 0.22 * strength * (1.0 - strong);

    // Strong: the path of the Shura. The world as the asura sees it: in
    // ink and blood, its light gone to embers, the edges burning.
    float l2 = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 ink = vec3(0.04, 0.022, 0.024);
    vec3 ember = vec3(1.0, 0.74, 0.5);
    vec3 duo = mix(ink, blood * 0.42, smoothstep(0.02, 0.42, l2));
    duo = mix(duo, blood * 0.95, smoothstep(0.38, 0.78, l2));
    duo = mix(duo, ember, smoothstep(0.76, 1.0, l2));
    // Reds stay red, a little brighter.
    duo = mix(duo, c.rgb * vec3(1.15, 0.85, 0.8), warm * 0.35);
    c.rgb = mix(c.rgb, duo, 0.82 * strong);
    float burn = smoothstep(0.3, 0.8, length(d * vec2(1.3, 1.0)));
    c.rgb = mix(c.rgb, c.rgb * vec3(0.55, 0.16, 0.1) + vec3(0.06, 0.0, 0.0), burn * 0.55 * strong);
    c.rgb += (grain(gl_FragCoord.xy) - 0.5) * 0.035 * strong;

    fragColor = vec4(clamp(c.rgb, 0.0, 1.0), c.a);
}
