#version 320 es
// Screen grade for the Wabi-sabi desktop theme, applied by Hyprland to the
// whole output (decoration:screen_shader). services/DesktopTheme.qml fills in
// the @PLACEHOLDERS@ and writes the result to
// ~/.cache/quickshell/desktop-theme.frag.
//
// Deliberately static: it never reads `time` (grain and paper are fixed
// patterns), so Hyprland keeps its damage tracking and an idle desktop costs
// nothing.

precision highp float;

in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

const vec3 accent = vec3(@ACCENT@);
const float strength = @STRENGTH@;
const float strong = @STRONG@;

float grain(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

float hash(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
               mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}

void main() {
    vec4 c = texture(tex, v_texcoord);
    float lum = dot(c.rgb, vec3(0.2126, 0.7152, 0.0722));

    // Faded colour, like a print that has seen some sun.
    c.rgb = mix(c.rgb, vec3(lum), 0.12 * strength + 0.1 * strong);

    // Warm paper in the highlights, warm sumi instead of black.
    c.rgb = mix(c.rgb, c.rgb * vec3(1.0, 0.95, 0.86), smoothstep(0.35, 1.0, lum) * 0.3 * strength);
    c.rgb += vec3(0.05, 0.04, 0.03) * (1.0 - smoothstep(0.0, 0.3, lum)) * strength;

    // Strong: the uneven tone of old handmade paper, and a trace of the
    // theme's muted accent in the midtones.
    float blot = noise(gl_FragCoord.xy / 90.0) * 0.6 + noise(gl_FragCoord.xy / 23.0) * 0.4;
    c.rgb *= 1.0 - (blot - 0.5) * 0.05 * strong;
    c.rgb = mix(c.rgb, c.rgb * (0.75 + 0.35 * accent), strong * 0.1 * (1.0 - abs(lum - 0.5) * 2.0));

    // Paper grain.
    c.rgb += (grain(floor(gl_FragCoord.xy)) - 0.5) * (0.02 + 0.02 * strong);

    // Edges aged to brown rather than darkened to black.
    vec2 d = v_texcoord - 0.5;
    float r = length(d * vec2(1.0, 1.1));
    c.rgb = mix(c.rgb, c.rgb * vec3(0.84, 0.75, 0.62), smoothstep(0.55, 1.0, r) * 0.3 * strength);

    fragColor = vec4(clamp(c.rgb, 0.0, 1.0), c.a);
}
